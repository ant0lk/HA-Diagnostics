# Standalone import-only profile: not installed under Supervisor, no HA token injection.
FROM python:3.13.12-slim-bookworm@sha256:a58daefb915e1e03ad48f3ca4df8832065412c5c35cacb9d39f4229184de12b6
LABEL org.opencontainers.image.title="HA-Diagnostics Import" org.opencontainers.image.version="1.0.0-alpha.4" org.opencontainers.image.source="https://github.com/ant0lk/HA-Diagnostics"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/ha-diagnostics/src HAD_PROFILE=import_only
WORKDIR /opt/ha-diagnostics
COPY requirements.lock ./requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock
COPY src ./src
COPY schemas ./schemas
COPY web ./web
ENTRYPOINT ["python", "-m", "ha_diagnostics.runtime"]
