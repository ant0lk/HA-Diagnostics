# Build from the staged app directory generated by scripts/package_release.py.
# OCI index binds both linux/amd64 and linux/arm64. No floating base tags.
FROM python:3.13.12-slim-bookworm@sha256:a58daefb915e1e03ad48f3ca4df8832065412c5c35cacb9d39f4229184de12b6
ARG BUILD_ARCH
LABEL io.hass.name="HA-Diagnostics" io.hass.description="Read-only diagnostic ZIP; preliminary alpha" io.hass.version="1.0.0-alpha.6" io.hass.type="addon" io.hass.arch="${BUILD_ARCH}"
LABEL org.opencontainers.image.title="HA-Diagnostics" org.opencontainers.image.version="1.0.0-alpha.6" org.opencontainers.image.source="https://github.com/ant0lk/HA-Diagnostics"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/opt/ha-diagnostics/src
WORKDIR /opt/ha-diagnostics
COPY app/requirements.lock ./requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock
COPY app/src ./src
COPY app/schemas ./schemas
COPY app/web ./web
COPY app/tunnel ./tunnel
RUN chmod -R a+rX /opt/ha-diagnostics && python -c "from pathlib import Path; [p.chmod(0o555) for p in Path('/opt/ha-diagnostics/tunnel').glob('*/tunnel-client-runtime')]"
EXPOSE 8099
ENTRYPOINT ["python", "-m", "ha_diagnostics.runtime"]
