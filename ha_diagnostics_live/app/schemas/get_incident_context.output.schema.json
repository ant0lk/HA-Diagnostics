      "required": [
        "device_ref",
        "entity_refs",
        "states",
        "state_origin",
        "snapshot_is_historical_evidence"
      ],
      "title": "DeviceContextData",
      "type": "object"
    },
    "Empty": {
      "additionalProperties": false,
      "properties": {},
      "title": "Empty",
      "type": "object"
    },
    "EntitySnapshotOutput": {
      "additionalProperties": false,
