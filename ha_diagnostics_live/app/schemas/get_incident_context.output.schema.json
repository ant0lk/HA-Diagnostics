              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Origin"
        },
        "level": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL",
            "UNKNOWN"
          ],
          "title": "Level",
          "type": "string"
        },
        "logger": {
          "anyOf": [
            {
              "maxLength": 220,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logger"
        },
        "sanitized_message": {
          "maxLength": 16020,
          "title": "Sanitized Message",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "occurrence": {
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "redaction_version": {
          "maxLength": 40,
          "title": "Redaction Version",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "local_locator": {
          "maxLength": 400,
          "title": "Local Locator",
          "type": "string"
        },
        "selection_time_basis": {
          "enum": [
            "event",
            "observation_only"
          ],
          "title": "Selection Time Basis",
          "type": "string"
        },
        "evidence_kind": {
          "anyOf": [
            {
              "const": "log",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Kind"
