      },
      "required": [
        "record_id",
        "source_id",
        "boot_id",
        "event_time_utc",
        "observed_at",
        "time_quality",
        "level",
        "sanitized_message",
        "fingerprint",
        "occurrence",
        "redaction_version",
        "truncated",
        "local_locator",
        "selection_time_basis"
