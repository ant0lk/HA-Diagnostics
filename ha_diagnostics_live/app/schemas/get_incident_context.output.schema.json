              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingestion Basis"
        },
        "dropped_count": {
          "default": 0,
          "minimum": 0,
          "title": "Dropped Count",
          "type": "integer"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "GapOutput",
      "type": "object"
    },
    "IncidentData": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceContextData"
        },
        "timeline": {
          "items": {
