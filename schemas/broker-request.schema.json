      "boots": "#/$defs/BootRead",
      "device_catalog": "#/$defs/DeviceCatalogRead",
      "entity_catalog": "#/$defs/EntityCatalogRead",
      "history": "#/$defs/HistoryRead",
      "logs": "#/$defs/LogRead",
